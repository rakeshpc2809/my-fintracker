{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": true,
    "removeComments": true,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "truncateBase64": true
  },
  "ignore": {
    "useGitignore": true,
    "useDefaultIgnore": true,
    "customPatterns": [
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/yarn.lock",
      "**/build/**",
      "**/dist/**",
      "**/data/**",
      "*.duckdb*",
      "*.zip",
      "*.pdf",
      "*.log",
      "repomix-output.*",
      "repowise-wiki-export/**",
      ".repowise/**",
      "**/gradlew*",
      "**/gradle/**",
      "**/.gradle/**",
      "**/*.jar",
      "**/*.bin"
    ]
  }
}

